{
  "name": "routine-tracker",
  "version": "1.4.1",
  "description": "OBS overlay controller for dance competition routines",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --publish=never"
  },
  "build": {
    "appId": "com.routinetracker.app",
    "productName": "Routine Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "fonts/**/*",
      "images/**/*"
    ],
    "afterSign": "build/afterSign.js",
    "afterAllArtifactBuild": "build/afterAllArtifactBuild.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "tony zuppardo (74A7NU2R45)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "artifactName": "Routine-Tracker-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "conquerdesigngroup",
        "repo": "routine-tracker"
      }
    ]
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
